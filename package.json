{
  "name": "dsh-game-material-master",
  "version": "0.11.2",
  "description": "游戏素材大师：DSH 插件，包含八方向图生成、图片生成、序列帧生成、45° 地图编辑器、俯视地图编辑器、音乐生成编辑、音效生成七个正式模块，以及实验性的骨骼动画生成。对话工具面只注册一个 game_material（按需读手册）；45° 与俯视两套地图编辑器全本地零计费（等距 2:1 / A2 自动连接 / 多格物件 / 动画 / 标记 / 环绕 / 一键生成 / AI 生成素材回链导入）；音乐接谱乐 AI（灵感或歌词 → 新对话生成 → 回界面裁剪导出，另有本地谱曲模式）；音效接火山引擎 Seed-Audio。生图默认火山方舟 Seedream，也可选自定义三家协议或 ToAPIs 异步接口；图生视频默认 MiniMax，也可选本机 ComfyUI 或 ToAPIs；抠像 / 抽帧 / 合成 / 音乐后期全部在本机完成。界面与内置提示词支持中 / 英。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/universe-st/dsh-game-material-master.git"
  },
  "homepage": "https://github.com/universe-st/dsh-game-material-master#readme",
  "bugs": {
    "url": "https://github.com/universe-st/dsh-game-material-master/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    "lib",
    "README.md",
    "README.en.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:rig:runtime": "node scripts/verify-rig-runtime.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@esotericsoftware/spine-core": "4.2.120",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "game-assets",
    "sprite-sheet",
    "chroma-key",
    "seedream",
    "minimax",
    "tilemap-editor",
    "tileset",
    "autotile",
    "wraparound",
    "music-generation",
    "ai-music",
    "scoremill",
    "midi-composition",
    "audio-editing",
    "puyue",
    "suno",
    "sound-effects",
    "sfx",
    "seed-audio",
    "volcengine",
    "isometric",
    "45-degree",
    "map-editor"
  ]
}
